{
  "manifest_version": 3,
  "name": "Claude Censor",
  "version": "1.0.0",
  "description": "Replaces unwanted text on every page in real time.",
  "minimum_chrome_version": "123",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Claude Censor",
    "default_popup": "src/popup/popup.html?popup"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/shadow-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dist/main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
